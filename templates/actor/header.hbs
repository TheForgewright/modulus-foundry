<header class="modulus-header">
  <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-edit="img" data-action="editImage" width="96" height="96">
  <div class="header-fields">
    <input class="actor-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'Name'}}" {{#unless editable}}disabled{{/unless}}>
    <div class="header-row">
      <label>{{localize "MODULUS.Field.xp.total"}} <input type="number" name="system.xp.total" value="{{source.xp.total}}" min="0" step="1" {{#unless isGM}}disabled{{/unless}}></label>
      <label>{{localize "MODULUS.Field.xp.spent"}} <input type="number" name="system.xp.spent" value="{{source.xp.spent}}" min="0" step="1" {{#unless isGM}}disabled{{/unless}}></label>
      <label>{{localize "MODULUS.Field.xp.available"}} <input type="number" value="{{system.xp.available}}" disabled></label>
      <span class="threshold" data-tooltip="MODULUS.Threshold.Tooltip">
        {{localize "MODULUS.Threshold.Label"}} <strong>{{system.threshold}}</strong>
        <span class="hint">{{#if system.nextThreshold}}{{localize "MODULUS.Threshold.Next" xp=system.nextThreshold n=system.toNextThreshold}}{{else}}{{localize "MODULUS.Threshold.Top"}}{{/if}}</span>
      </span>
      <label>{{localize "MODULUS.Field.respecPoints"}} <input type="number" name="system.respecPoints" value="{{source.respecPoints}}" min="0" step="1" {{#unless isGM}}disabled{{/unless}}></label>
      {{#if creation.canOpen}}{{#if creation.created}}<button type="button" class="secondary" data-action="openCreation" data-tooltip="MODULUS.Creation.RerunTooltip"><i class="fa-solid fa-user-pen"></i> {{localize "MODULUS.Creation.Title"}}</button>{{/if}}{{/if}}
      <button type="button" class="roll-button" data-action="buildAction"><i class="fa-solid fa-hand-fist"></i> {{localize "MODULUS.Builder.Open"}}</button>
      <button type="button" class="roll-button secondary" data-action="rollManual"><i class="fa-solid fa-dice-d20"></i> {{localize "MODULUS.Roll.Roll"}}</button>
    </div>
  </div>
</header>
