<div class="modulus-item">
  <header class="modulus-header">
    <img class="profile" src="{{item.img}}" alt="" data-edit="img" data-action="editImage" width="64" height="64">
    <input class="item-name" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}}>
  </header>

  {{#each scalar}}
  {{formGroup field value=value localize=true}}
  {{/each}}

  {{#if isSkill}}
  <div class="form-group"><label>{{localize "MODULUS.Field.xpSpent"}}</label><input type="number" value="{{system.xpSpent}}" disabled></div>
  {{/if}}

  {{!-- Tags (§6.4) --}}
  {{#if hasTags}}
  <fieldset class="tag-editor">
    <legend>{{localize "MODULUS.Field.tags"}}</legend>
    <div class="tag-chips">
      {{#each tags}}
      <span class="tag-chip {{#if engine}}engine{{/if}}" data-index="{{index}}" {{#if tooltip}}data-tooltip="{{tooltip}}"{{/if}}>
        <input type="hidden" name="_tags.{{index}}.name" value="{{name}}">
        <span class="tag-name">{{name}}</span>
        <input type="number" class="tag-value" name="_tags.{{index}}.value" value="{{value}}" step="1" data-tooltip="MODULUS.Item.TagValue">
        {{#if ../editable}}<a class="remove" data-action="removeTag"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </span>
      {{/each}}
    </div>
    {{#if editable}}
    <div class="tag-add">
      <input type="text" class="new-tag" list="{{rootId}}-tags" placeholder="{{localize 'MODULUS.Item.AddTagPlaceholder'}}">
      <datalist id="{{rootId}}-tags">{{#each registry}}<option value="{{name}}">{{description}}</option>{{/each}}</datalist>
      <button type="button" data-action="addTag"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Item.AddTag"}}</button>
    </div>
    {{/if}}
  </fieldset>
  {{/if}}

  {{!-- Effects (§6.3) --}}
  {{#if hasEffects}}
  <fieldset class="effects-editor">
    <legend>{{localize "MODULUS.Field.effects"}}</legend>
    {{#each effects}}
    <div class="effect-row {{#if errors.length}}invalid{{/if}}" data-index="{{index}}">
      <div class="effect-head">
        <select name="_fx.{{index}}.trigger" data-tooltip="MODULUS.Effect.TriggerLabel">{{selectOptions ../triggerOptions selected=trigger}}</select>
        <select name="_fx.{{index}}.op" data-tooltip="MODULUS.Effect.OpLabel">{{selectOptions ../opOptions selected=op}}</select>
        <select name="_fx.{{index}}.to" data-tooltip="MODULUS.Effect.ToLabel">{{selectOptions ../targetOptions selected=to}}</select>
        {{#if canDelay}}<label class="effect-delay" data-tooltip="MODULUS.Delayed.FieldHint"><i class="fa-solid fa-hourglass-half"></i> <input type="number" name="_fx.{{index}}.delay" value="{{delay}}" min="0" step="1"></label>{{/if}}
        {{#if ../editable}}
        <span class="effect-controls">
          <a data-action="moveEffect" data-dir="-1" data-tooltip="MODULUS.Effect.MoveUp"><i class="fa-solid fa-arrow-up"></i></a>
          <a data-action="moveEffect" data-dir="1" data-tooltip="MODULUS.Effect.MoveDown"><i class="fa-solid fa-arrow-down"></i></a>
          <a data-action="removeEffect" data-tooltip="DOCUMENT.Delete"><i class="fa-solid fa-trash"></i></a>
        </span>
        {{/if}}
      </div>
      {{#if json}}
      <textarea class="json" name="_fx.{{index}}.argsJSON" rows="4" spellcheck="false">{{argsJSON}}</textarea>
      <p class="hint">{{localize "MODULUS.Effect.JSONArgsHint"}}</p>
      {{else}}
      <div class="effect-args">
        {{#each args}}
        <label class="effect-arg">
          <span>{{label}}{{#if optional}} <em>({{localize "MODULUS.Effect.Optional"}})</em>{{/if}}</span>
          {{#if isInt}}<input type="number" name="{{name}}" value="{{value}}" step="1">{{/if}}
          {{#if isBool}}<input type="checkbox" name="{{name}}" {{checked value}}>{{/if}}
          {{#if isStat}}<select name="{{name}}">{{#if optional}}<option value=""></option>{{/if}}{{selectOptions ../../statOptions selected=value}}</select>{{/if}}
          {{#if isSelect}}<select name="{{name}}">{{selectOptions options selected=value}}</select>{{/if}}
          {{#if isTag}}<input type="text" name="{{name}}" value="{{value}}" list="{{../../rootId}}-tags">{{/if}}
          {{#if isText}}<input type="text" name="{{name}}" value="{{value}}">{{/if}}
        </label>
        {{/each}}
      </div>
      {{/if}}
      <p class="effect-preview">{{description}}</p>
      {{#each errors}}<p class="effect-error">{{this}}</p>{{/each}}
    </div>
    {{else}}
    <p class="hint">{{localize "MODULUS.Effect.None"}}</p>
    {{/each}}
    {{#if editable}}
    <div class="effect-add">
      <select class="new-effect-op">{{selectOptions opOptions}}</select>
      <button type="button" data-action="addEffect"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Effect.Add"}}</button>
    </div>
    {{/if}}
  </fieldset>
  {{/if}}


  {{!-- Talent editor (§8, §8.1) --}}
  {{#with talent}}
  {{#*inline "mfield"}}
  <label class="cfx-field">
    <span>{{label}}</span>
    {{#if isSelect}}<select name="{{name}}">{{selectOptions options selected=value}}</select>{{/if}}
    {{#if isInt}}<input type="number" name="{{name}}" value="{{value}}" step="1">{{/if}}
    {{#if isBool}}<input type="checkbox" name="{{name}}" {{checked value}}>{{/if}}
    {{#if isText}}<input type="text" name="{{name}}" value="{{value}}">{{/if}}
  </label>
  {{/inline}}
  <fieldset class="talent-prereqs">
    <legend>{{localize "MODULUS.Talent.Prerequisites"}}</legend>
    {{#if needsPrereq}}
    <div class="form-group">
      <label>{{localize (concat "MODULUS.Talent.PrereqFor." tier)}}</label>
      <select name="system.prereqTalent">{{selectOptions prereqOptions selected=prereq}}</select>
    </div>
    {{#if isTier3}}
    <div class="form-group">
      <label>{{localize "MODULUS.Talent.CrossPrereq"}}</label>
      <select name="system.crossPrereq">{{selectOptions crossOptions selected=cross}}</select>
    </div>
    {{/if}}
    <p class="hint">{{localize (concat "MODULUS.Talent.RequiresTier." tier)}}</p>
    {{else}}
    <p class="hint">{{localize "MODULUS.Talent.Tier1Open"}}</p>
    {{/if}}
    {{#each issues}}<p class="effect-error"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    <button type="button" class="secondary" data-action="openTalentGraph"><i class="fa-solid fa-diagram-project"></i> {{localize "MODULUS.Talent.Graph"}}</button>
  </fieldset>

  <details class="talent-principles">
    <summary>{{localize "MODULUS.Talent.PrinciplesTitle"}}</summary>
    <ul>
      <li>{{localize "MODULUS.Talent.Principle.1"}}</li>
      <li>{{localize "MODULUS.Talent.Principle.2"}}</li>
      <li>{{localize "MODULUS.Talent.Principle.3"}}</li>
      <li>{{localize "MODULUS.Talent.Principle.4"}}</li>
      <li>{{localize "MODULUS.Talent.Principle.5"}}</li>
      <li>{{localize "MODULUS.Talent.Principle.6"}}</li>
    </ul>
  </details>

  <fieldset class="cfx-editor">
    <legend>{{localize "MODULUS.Field.conditionalEffects"}}</legend>
    {{#each cfx}}
    <div class="cfx-row {{#if errors.length}}invalid{{/if}}" data-cfx="{{index}}">
      <div class="cfx-head">
        <input type="hidden" name="{{idName}}" value="{{id}}">
        <input type="text" name="{{labelName}}" value="{{label}}" placeholder="{{localize 'MODULUS.Talent.Field.label'}}">
        {{#if ../../editable}}<a data-action="removeCfx" data-tooltip="DOCUMENT.Delete"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      <div class="cfx-section"><strong>{{localize "MODULUS.Talent.When"}}</strong><div class="cfx-fields">{{#each triggerFields}}{{> mfield}}{{/each}}</div></div>
      <div class="cfx-section">
        <strong>{{localize "MODULUS.Talent.If"}}</strong>
        {{#each conditions}}
        <div class="cfx-fields cfx-sub">{{#each fields}}{{> mfield}}{{/each}}<a data-action="removeCfxPart" data-part="condition" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a></div>
        {{else}}<span class="hint">{{localize "MODULUS.Talent.NoConditions"}}</span>{{/each}}
        <a class="cfx-add" data-action="addCfxPart" data-part="condition"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Talent.AddCondition"}}</a>
      </div>
      <div class="cfx-section">
        <strong>{{localize "MODULUS.Talent.Gives"}}</strong>
        {{#each shifts}}<div class="cfx-fields cfx-sub">{{#each fields}}{{> mfield}}{{/each}}<a data-action="removeCfxPart" data-part="shift" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a></div>{{/each}}
        {{#each dice}}<div class="cfx-fields cfx-sub">{{#each fields}}{{> mfield}}{{/each}}<a data-action="removeCfxPart" data-part="dice" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a></div>{{/each}}
        <a class="cfx-add" data-action="addCfxPart" data-part="shift"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Talent.AddShift"}}</a>
        <a class="cfx-add" data-action="addCfxPart" data-part="dice"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Talent.AddDice"}}</a>
        <div class="cfx-fields">{{#each grantFields}}{{> mfield}}{{/each}}</div>
      </div>
      <div class="cfx-section"><strong>{{localize "MODULUS.Talent.For"}}</strong><div class="cfx-fields">{{#each timeFields}}{{> mfield}}{{/each}}</div></div>
      <p class="effect-preview">{{preview}}</p>
      {{#each errors}}<p class="effect-error">{{this}}</p>{{/each}}
      {{#each warnings}}<p class="hint"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    </div>
    {{else}}
    <p class="hint">{{localize "MODULUS.Talent.NoCfx"}}</p>
    {{/each}}
    {{#if ../editable}}<button type="button" data-action="addCfx"><i class="fa-solid fa-plus"></i> {{localize "MODULUS.Talent.AddCfx"}}</button>{{/if}}
  </fieldset>
  {{/with}}

  {{#each lists}}
  <div class="form-group">
    <label>{{label}}</label>
    <input type="text" name="system.{{key}}" value="{{value}}">
  </div>
  {{/each}}

  {{#each json}}
  <div class="form-group stacked">
    <label>{{label}}</label>
    <textarea class="json" name="system.{{key}}" rows="6" spellcheck="false">{{value}}</textarea>
    <p class="hint">{{localize "MODULUS.Item.JSONHint"}}</p>
  </div>
  {{/each}}

  <div class="form-group stacked description">
    <label>{{localize "MODULUS.Field.description"}}</label>
    {{formInput descriptionField enriched=descriptionHTML value=system._source.description name="system.description" toggled=true}}
  </div>
</div>
